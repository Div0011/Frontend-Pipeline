generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  role      Role     @default(customer)
  createdAt DateTime @default(now())

  reviews Review[]
  quotes  Quote[]
  leads   Lead[]
}

enum Role {
  customer
  vendor
  admin
}

model City {
  id              String @id @default(cuid())
  slug            String @unique
  name            String
  state           String
  imageUrl        String?
  avgPrice1bhkLocal Float?

  companies Company[]
}

model Company {
  id              String @id @default(cuid())
  slug            String @unique
  name            String
  ownerName       String
  gstin           String
  cityId          String
  city            City   @relation(fields: [cityId], references: [id])
  address         String
  phone           String
  email           String
  website         String?
  yearsInBusiness Int
  services        String[]
  logoUrl         String?
  coverUrl        String?
  isVerified      Boolean @default(false)
  status          CompanyStatus @default(pending)
  createdAt       DateTime @default(now())

  reviews Review[]
  leads   Lead[]
  quotes  Quote[]

  @@index([cityId])
  @@index([status])
}

enum CompanyStatus {
  pending
  approved
  rejected
}

model Review {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int      @range(1, 5)
  text      String
  moveDate  String
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())
}

model Quote {
  id                  String   @id @default(cuid())
  fromCity            String
  toCity              String
  homeSize            String
  inventory           String[]
  moveDate            String
  customerName        String
  email               String
  phone               String
  estimatedPriceMin   Float?
  estimatedPriceMax   Float?
  status              QuoteStatus @default(new)
  createdAt           DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}

enum QuoteStatus {
  new
  contacted
  converted
  closed
}

model Lead {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  email      String
  phone      String
  message    String
  createdAt  DateTime @default(now())
}
